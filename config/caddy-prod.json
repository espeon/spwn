{
  "admin": {
    "listen": "caddy:2019"
  },
  "apps": {
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": ["{env.DOMAIN}", "*.{env.DOMAIN}"],
            "issuers": [
              {
                "module": "acme",
                "email": "{env.ACME_EMAIL}",
                "challenges": {
                  "dns": {
                    "provider": {
                      "name": "cloudflare",
                      "api_token": "{env.CF_API_TOKEN}"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    },
    "http": {
      "servers": {
        "main": {
          "listen": [":80", ":443"],
          "routes": []
        }
      }
    }
  }
}
